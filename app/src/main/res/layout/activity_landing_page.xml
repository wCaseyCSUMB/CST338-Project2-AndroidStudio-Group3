<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/text_welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/text_admin_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#C62828"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_marginBottom="24dp"
            android:visibility="gone"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Weather"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#424242"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/text_weather_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WIP, WEATHER DATA MAY APPEAR HERE WHEN API IS IMPLEMENTED"
                android:textColor="#757575"
                android:textSize="14sp"/>

        </LinearLayout>

        <!--Admin/premium Button -->
        <Button
            android:id="@+id/btn_admin_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Admin Panel"
            android:backgroundTint="#C62828"
            android:layout_marginBottom="16dp"
            android:visibility="gone"/>


        <Button
            android:id="@+id/btn_view_weather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Search Weather"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btn_favorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Favorites"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btn_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Search History"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:backgroundTint="#757575"/>

    </LinearLayout>

</ScrollView>