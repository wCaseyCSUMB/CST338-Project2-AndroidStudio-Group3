<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F7FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/header_weather"
            android:layout_width="match_parent"
            android:layout_height="430dp"
            android:background="@drawable/weather_header_gradient">

            <LinearLayout
                android:id="@+id/header_welcome_area"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/text_welcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/text_admin_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Admin"
                    android:visibility="gone" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_current_weather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingLeft="32dp"
                android:paddingRight="32dp"
                android:paddingBottom="34dp">

                <TextView
                    android:id="@+id/text_home_city"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textSize="22sp"
                    android:fontFamily="@font/torus_bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="-10dp" />

                <LinearLayout
                    android:id="@+id/temperature_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="7dp">

                    <TextView
                        android:id="@+id/text_home_temperature"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=""
                        android:textSize="80sp"
                        android:fontFamily="@font/torus_bold"
                        android:textStyle="bold"
                        android:textColor="#001124"
                        android:includeFontPadding="false" />

                    <ImageView
                        android:id="@+id/image_home_sun"
                        android:layout_width="125dp"
                        android:layout_height="125dp"
                        android:src="@drawable/sun"
                        android:contentDescription="Weather icon"
                        android:layout_marginStart="16dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/text_home_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="20sp"
                    android:fontFamily="@font/varela_round_regular"
                    android:textColor="#004E96"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/text_home_feels_like"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="16sp"
                    android:fontFamily="@font/varela_round_regular"
                    android:textColor="#004E96"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:id="@+id/text_home_high_low"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="15sp"
                    android:fontFamily="@font/varela_round_regular"
                    android:textStyle="bold"
                    android:textColor="#004E96"
                    android:gravity="end" />

            </LinearLayout>

        </FrameLayout>

        <LinearLayout
            android:id="@+id/content_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="30dp">

            <LinearLayout
                android:id="@+id/layout_home_details_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:id="@+id/card_home_humidity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/card"
                    android:padding="16dp"
                    android:elevation="0dp">

                    <ImageView
                        android:id="@+id/image_home_humidity"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ico_humidity"
                        android:contentDescription="Humidity icon"
                        android:layout_marginEnd="12dp"
                        app:tint="#27517A" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Humidity"
                            android:textSize="15sp"
                            android:fontFamily="@font/torus_bold"
                            android:textColor="#27517A" />

                        <TextView
                            android:id="@+id/text_home_humidity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--%"
                            android:textSize="16sp"
                            android:fontFamily="@font/varela_round_regular"
                            android:textColor="#004E96"
                            android:layout_marginTop="3dp" />

                    </LinearLayout>

                </LinearLayout>

                <Space
                    android:layout_width="14dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/card_home_wind"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/card"
                    android:padding="16dp"
                    android:elevation="0dp">

                    <ImageView
                        android:id="@+id/image_home_wind"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ico_wind"
                        android:contentDescription="Wind icon"
                        android:layout_marginEnd="12dp"
                        app:tint="#27517A" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wind"
                            android:textSize="15sp"
                            android:fontFamily="@font/torus_bold"
                            android:textColor="#27517A" />

                        <TextView
                            android:id="@+id/text_home_wind"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- mph"
                            android:textSize="16sp"
                            android:fontFamily="@font/varela_round_regular"
                            android:textColor="#004E96"
                            android:layout_marginTop="3dp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>